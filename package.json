{
  "name": "pi-crypto-gate",
  "version": "0.3.0",
  "description": "Pi-family policy gate between an AI agent and an onchain wallet: propose a payment, the gate allows it, holds it for human approval, or blocks it, with an append-only receipt log and an optional zero-knowledge spending policy (ERC-8366): a Groth16 proof that an allowed payment is within a private per-transaction cap, verified on chain. Sits downstream of a crypto screener; pairs with pi-gate.",
  "license": "MIT",
  "author": "Rene Zander",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renezander030/pi-crypto-gate.git"
  },
  "homepage": "https://github.com/renezander030/pi-crypto-gate#readme",
  "bugs": {
    "url": "https://github.com/renezander030/pi-crypto-gate/issues"
  },
  "type": "module",
  "bin": {
    "pi-crypto-gate": "bin/pi-crypto-gate.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "README.md",
    "LICENSE",
    "zk/src",
    "zk/circuits",
    "zk/artifacts",
    "zk/README.md",
    "fhe/src",
    "fhe/README.md"
  ],
  "scripts": {
    "demo": "node bin/pi-crypto-gate.js demo",
    "test": "node --test",
    "zk:build": "node zk/scripts/build.mjs",
    "zk:ceremony": "node zk/scripts/build.mjs --ceremony",
    "zk:e2e": "sh zk/scripts/e2e-anvil.sh",
    "test:contracts": "forge test --root zk/contracts",
    "fhe:demo": "sh fhe/scripts/demo.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "onchain",
    "payments",
    "policy",
    "spend-cap",
    "approval",
    "hitl",
    "pi-gate",
    "x402",
    "zero-knowledge",
    "zk-snark",
    "groth16",
    "erc-8366",
    "circom",
    "snarkjs",
    "usdc",
    "erc-3009",
    "eip-1271",
    "spending-policy",
    "agent-payments",
    "wallet-guardrails",
    "homomorphic-encryption",
    "fhe",
    "sealed-policy",
    "microsoft-seal"
  ],
  "devDependencies": {
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "node-seal": "^7.0.0",
    "snarkjs": "^0.7.6"
  },
  "peerDependencies": {
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6",
    "node-seal": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    },
    "circomlibjs": {
      "optional": true
    },
    "node-seal": {
      "optional": true
    }
  }
}
